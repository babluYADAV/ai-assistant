# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth2 credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-backend-url.vercel.app/auth/google/callback

# Optional override for where OAuth tokens are stored. In Vercel, leave this unset to use a temp path.
TOKEN_STORE_PATH=

PORT=5000
FRONTEND_ORIGIN=https://your-frontend-url.vercel.app
